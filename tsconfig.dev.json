{
  // Everything that runs on Node at development time: the scripts that build
  // the language model and the test suite. Unlike the library itself, this code
  // is allowed to touch the filesystem.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true
  },
  "references": [{ "path": "./tsconfig.src.json" }],
  "include": ["scripts/**/*.ts", "test/**/*.ts"]
}
