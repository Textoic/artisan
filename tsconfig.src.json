{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // The library must run unmodified in a browser, so it is compiled without
    // any environment-specific globals. Referencing a Node API from src is a
    // compile error, not something to discover at runtime.
    "types": [],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"]
}
